# Configuração do projeto (12-factor). Copie para .env e ajuste; o .env NUNCA é versionado.
# O SQL Server exige senha forte: 8+ caracteres com maiúscula, minúscula, dígito e símbolo.

# --- SQL Server do sistema comercial simulado + staging (docker compose em staging/, serviço "sqlserver") ---
# Dois bancos no mesmo servidor: ORIGEM_DB é a "produção" simulada (populada pelo gerador);
# STAGING_DB é o espelho carregado por marca d'água (carga incremental diária).
MSSQL_SA_PASSWORD=Troque-Esta-Senha-1
MSSQL_PORT=1433
ORIGEM_DB=db_fictoria
STAGING_DB=stg_fictoria
# MSSQL_HOST=localhost
# MSSQL_USER=sa

# --- Lake (bronze/silver/gold em parquet; URL fsspec) ---
# Padrão: data/lake (local, gitignorado). Para S3/MinIO: s3://bucket/caminho
# LAKE_URL=data/lake

# --- Warehouse multidimensional (docker compose, serviço "warehouse") ---
DW_DB=dw_fictoria
DW_SA_PASSWORD=Troque-Esta-Senha-Tambem-2
DW_PORT=1434
# Carga seletiva por partição (ex.: 2024,2025,2026). Vazio = todos os anos.
# DW_ANOS=

# Para apontar a carga a um SQL Server externo (ex.: Azure SQL), sobrescreva DW_HOST/DW_PORT/etc.
# DW_HOST=localhost
# DW_USER=sa
#
# Ou informe a string de conexão ODBC completa (tem precedência sobre as partes acima):
# DW_URL=Driver={ODBC Driver 18 for SQL Server};Server=tcp:servidor.database.windows.net,1433;Database=dw_fictoria;Uid=usuario;Pwd=senha;Encrypt=yes
# Dica: guarde o destino em nuvem num arquivo separado (.env.nuvem, gitignorado) e rode
#   uv run carga-dw --env .env.nuvem
# O .env continua apontando para o container local.

# --- Driver ODBC (nome registrado no odbcinst.ini; o padrão serve para o Driver 18) ---
# ODBC_DRIVER=ODBC Driver 18 for SQL Server
